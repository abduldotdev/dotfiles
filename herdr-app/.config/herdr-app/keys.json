{
  "global": {
    "ctrl-space c": "tab.new",
    "ctrl-space r": "tab.rename",
    "ctrl-space k": "tab.close",
    "ctrl-space shift-c": "space.new",
    "ctrl-space shift-r": "space.rename",
    "ctrl-space shift-k": "space.close",
    "ctrl-space v": "pane.split:right",
    "ctrl-space h": "pane.split:down",
    "ctrl-space x": "pane.close",
    "ctrl-space z": "pane.zoom",
    "ctrl-space b": "layout.toggle:sidebar",
    "ctrl-space alt-s": "app.settings",
    "ctrl-space alt-g": "mod.open:picker",
    "ctrl-space g": "mod.open:lazygit",
    "ctrl-space d": "window.close",
    "ctrl-space shift-d": { "command": "tab.new", "args": { "mod": "files", "name": "Files" } },
    "alt-1": "tab.select:1",
    "alt-2": "tab.select:2",
    "alt-3": "tab.select:3",
    "alt-4": "tab.select:4",
    "alt-5": "tab.select:5",
    "alt-6": "tab.select:6",
    "alt-7": "tab.select:7",
    "alt-8": "tab.select:8",
    "alt-9": "tab.select:9",
    "alt-left": "tab.prev",
    "alt-right": "tab.next",
    "alt-up": "space.prev",
    "alt-down": "space.next",
    "ctrl-alt-left": "pane.go:left",
    "ctrl-alt-down": "pane.go:down",
    "ctrl-alt-up": "pane.go:up",
    "ctrl-alt-right": "pane.go:right",
    "alt-shift-h": "pane.swap:left",
    "alt-shift-j": "pane.swap:down",
    "alt-shift-k": "pane.swap:up",
    "alt-shift-l": "pane.swap:right",
    "ctrl-+": "app.zoom_in",
    "ctrl--": "app.zoom_out",
    "ctrl-0": "app.zoom_reset",
    "ctrl-=": "app.zoom_in",
    "ctrl-?": "app.help",
    "ctrl-shift-/": "app.help",
    "ctrl-shift-?": "app.help",
    "ctrl-shift-p": "app.palette",
    "ctrl-,": "app.settings",
    "ctrl-shift-l": "layout.switch"
  },
  "terminal": {
    "ctrl-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-shift-f": "terminal.search",
    "ctrl-v": "terminal.paste",
    "ctrl-insert": "terminal.copy",
    "shift-insert": "terminal.paste"
  }
}
